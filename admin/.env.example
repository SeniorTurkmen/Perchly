# Base URL of the perchly-backend API this dashboard talks to. Every
# call happens server-side (server components, Server Functions, route
# handlers) — never from the browser — so this never needs CORS
# configured on the backend.
BACKEND_URL=http://localhost:8080

# Engineering panel (/engineering) — shows open issues and recent PRs
# from this repo's GitHub. Leave both empty to skip that panel (it
# falls back to just the backend health check). GITHUB_TOKEN is a
# personal access token with at least read access to the repo ("repo"
# scope for a private repo, "public_repo" for a public one) — never
# reaches the browser, read server-side only, same as BACKEND_URL.
GITHUB_TOKEN=
GITHUB_REPO=SeniorTurkmen/Perchly
