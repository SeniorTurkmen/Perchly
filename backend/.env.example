SERVER_PORT=8080

DB_HOST=localhost
# 5433, not 5432: avoids clashing with a locally installed Postgres on the default port.
DB_PORT=5433
DB_USER=perchly
DB_PASSWORD=perchly
DB_NAME=perchly
DB_SSLMODE=disable

# Convenience DSN for the golang-migrate CLI, kept in sync with the DB_* vars above.
DATABASE_URL=postgres://perchly:perchly@localhost:5433/perchly?sslmode=disable

# LLM provider for POST /conversations/:id/messages. "anthropic" (default),
# "openai", "huggingface", and "gemini" are implemented today (internal/llm);
# "echo" needs no API key (streams the last user message back, for local
# dev/tests). Add another provider by implementing llm.Client and adding
# a case in llm.New — no handler/service changes needed.
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   LLM_BASE_URL=                # empty = https://api.anthropic.com
# OpenAI (or any OpenAI-compatible chat endpoint):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-proj-your-openai-api-key
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://api.openai.com
# Hugging Face Inference Providers (OpenAI-compatible router; token needs
# "Make calls to Inference Providers" — https://huggingface.co/settings/tokens):
#   LLM_PROVIDER=huggingface
#   LLM_API_KEY=hf_your-huggingface-token
#   LLM_MODEL=openai/gpt-oss-120b:fastest
#   LLM_BASE_URL=https://router.huggingface.co
# Gemini (Google AI Studio key — https://aistudio.google.com/apikey):
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=your-gemini-api-key   # or GEMINI_API_KEY
#   LLM_MODEL=gemini-2.5-flash
#   LLM_BASE_URL=                     # empty = https://generativelanguage.googleapis.com
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Only set this to point at a proxy/mock; leave empty for the real API.
LLM_BASE_URL=

# Embedding provider for message_embeddings (nearest-neighbor context
# retrieval) and rolling conversation summaries. "openai" is the default
# and must produce 1536-dim vectors to match the message_embeddings
# schema; "echo" needs no API key (deterministic bag-of-words vectors,
# for local dev/tests — see internal/embedding/echo.go). Add a provider by
# implementing embedding.Client and adding a case in embedding.New.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-proj-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty for https://api.openai.com; only set this to point at a
# proxy or OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=https://api.openai.com


# Signs access tokens (see internal/auth). Leave empty for local dev (a
# random per-process secret is generated, with a startup warning — tokens
# won't survive a restart); set a stable value anywhere tokens need to
# survive one.
JWT_SECRET=
# Access tokens are short-lived JWTs; refresh tokens are long-lived opaque
# tokens stored hashed in the database and rotated on every use (see
# AuthService.RefreshSession). 1440h = 60 days.
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_TTL=1440h

# How long an admin dashboard login (POST /admin/auth/login) lasts before
# requiring another one. Admin sessions are opaque tokens stored hashed
# in admin_sessions, same scheme as refresh tokens, just no rotation —
# see AdminAuthService. 168h = 7 days.
ADMIN_SESSION_TTL=168h

# Encrypts LLM provider API keys stored in llm_credentials (admin
# dashboard "AI Sağlayıcıları" panel) — AES-256-GCM, see internal/crypto
# and internal/config's doc comment. Leave empty for local dev (a random
# per-process key is generated, with a startup warning — any stored
# credential becomes undecryptable after a restart); set a stable
# base64-encoded 32-byte value anywhere stored credentials need to
# survive one. Generate with: openssl rand -base64 32
LLM_TOKEN_ENCRYPTION_KEY=

# SMTP sends the 6-digit email verification code (POST
# /auth/email/request-code) via gopkg.in/gomail.v2 — see
# internal/email/smtp.go. If SMTP_USERNAME or SMTP_PASSWORD is empty, the
# server logs codes to stdout instead of emailing them (internal/email/
# console.go) — fine for local dev, required for anything real. SMTP_PASSWORD
# must be a Google App Password, not your normal Gmail password — see
# README.md for how to generate one. Google shows it as "xxxx xxxx xxxx xxxx";
# paste that quoted (spaces/NBSP are stripped at startup):
# SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Perchly

# Free daily messages per user+persona before credit_balances kicks in as
# overage (see QuotaService). This is only the *default* for a brand new
# user_quotas row — a future admin dashboard can override it per
# user/persona by updating that row's daily_limit column directly.
DAILY_MESSAGE_LIMIT=20

# How often the background job checks for users whose local day has
# rolled over and resets message_count_today (per-user timezone, not
# server time — see QuotaRepository.ResetDueForNewLocalDay). A request
# also lazily self-heals this on every quota check, so this interval is
# about keeping the numbers fresh in the database, not correctness.
QUOTA_RESET_INTERVAL=1m

# Every request is logged to the request_logs table (see
# internal/requestlog): method, route, query/route params, body,
# device headers, status, duration — asynchronously, so it never adds
# latency. When true (the default), known-sensitive body/query field
# values (code, password, token, content, ...) are replaced with
# "[REDACTED]" before being written. Flip to false only for a short,
# deliberate debugging session — never in a shared or production
# environment, since it means verification codes and message content
# land in the database in plain text.
LOG_REDACT_SENSITIVE_FIELDS=true
