        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天你想找谁聊聊心事?"
          }
        }
      }
    },
    "Bugün küçük bir adım atmak istiyorum": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أريد اتخاذ خطوة صغيرة اليوم"
