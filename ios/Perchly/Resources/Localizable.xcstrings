    "Yargılamadan, olduğun gibi dinler.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع دون حكم، كما أنت تماماً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört zu, ohne zu urteilen — genau so, wie du bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens without judgment, just as you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha sin juzgar, tal como eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute sans juger, exactement comme tu es."
          }
