    "%@ İstersen başka birini seçebilirsin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يمكنك اختيار شخص آخر إن أردت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Du kannst auch jemand anderen wählen, wenn du möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ You can choose someone else if you'd like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Si quieres, puedes elegir a otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tu peux choisir quelqu'un d'autre si tu préfères."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Если хочешь, можешь выбрать кого-то другого."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 如果你愿意,也可以选择其他人。"
          }
        }
      }
    },
