    "Sadece geliştirme içindir. Cihazdaki oturumu, bağlı e-postayı ve cihaz kimliğini siler.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاستخدام في التطوير فقط. يحذف الجلسة والبريد الإلكتروني المرتبط ومعرّف الجهاز على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die Entwicklung. Löscht die Sitzung, die verknüpfte E-Mail und die Geräte-ID auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For development only. Deletes the session, linked email, and device id on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para desarrollo. Elimina la sesión, el correo vinculado y el id del dispositivo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservé au développement. Supprime la session, l'e-mail associé et l'identifiant de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для разработки. Удаляет сеанс, привязанную почту и id устройства на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供开发使用。将删除此设备上的会话、绑定邮箱和设备 ID。"
          }
        }
      }
    },
