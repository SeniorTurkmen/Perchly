    "Bugün kiminle dertleşmek istersin?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع من تريد التحدث اليوم؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit wem möchtest du dich heute austauschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who do you want to talk to today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con quién quieres desahogarte hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec qui veux-tu discuter aujourd'hui ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С кем ты хочешь поговорить по душам сегодня?"
