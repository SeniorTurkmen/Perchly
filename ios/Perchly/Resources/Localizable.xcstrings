    "Biraz dinlenmek istiyorum": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أريد أن أرتاح قليلاً"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich möchte mich etwas ausruhen"
          }
        },
        "en": {
