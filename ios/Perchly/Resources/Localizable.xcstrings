    "Çok fazla deneme yaptın, biraz sonra tekrar dene.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بعدد كبير جداً من المحاولات، حاول مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast zu oft versucht, versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've made too many attempts, try again in a bit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has hecho demasiados intentos, inténtalo de nuevo en un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fait trop de tentatives, réessaie un peu plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток, попробуй немного позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尝试的次数太多了,请稍后再试。"
          }
        }
      }
    },
    "Çok fazla hatalı deneme yaptın. Yeni bir kod istemen gerekiyor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بعدد كبير جداً من المحاولات الخاطئة. تحتاج إلى طلب رمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast zu viele falsche Versuche gemacht. Du musst einen neuen Code anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've made too many incorrect attempts. You'll need to request a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has hecho demasiados intentos incorrectos. Deberás solicitar un nuevo código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as fait trop de tentatives incorrectes. Tu dois demander un nouveau code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных попыток. Тебе нужно запросить новый код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误尝试次数过多,你需要请求一个新的验证码。"
          }
        }
      }
    },
