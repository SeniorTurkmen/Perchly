        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушает без осуждения, таким, какой ты есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不加评判地倾听真实的你。"
