    "Verilerini kaybetme, cihaz değiştirdiğinde de seninle kalsın.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تفقد بياناتك — احتفظ بها معك حتى عند تغيير جهازك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliere deine Daten nicht — behalte sie, auch wenn du das Gerät wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't lose your data — keep it with you when you switch devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pierdas tus datos: consérvalos contigo aunque cambies de dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne perds pas tes données — garde-les avec toi même en changeant d'appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не теряй свои данные — сохраняй их при смене устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要丢失你的数据——即使更换设备,也能继续保留。"
          }
        }
      }
    },
    "Yanıt çözümlenemedi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك ترميز الاستجابة."
