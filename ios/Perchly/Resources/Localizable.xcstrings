    "%@ adresine gönderdiğimiz 6 haneli kodu gir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز المكوّن من 6 أرقام الذي أرسلناه إلى %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den 6-stelligen Code ein, den wir an %@ gesendet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code we sent to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código de 6 dígitos que enviamos a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis le code à 6 chiffres que nous avons envoyé à %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 6-значный код, отправленный на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入我们发送到 %@ 的 6 位验证码。"
          }
        }
      }
    },
    "%@ bir sonraki adımı düşünüyor...": {
      "localizations": {
