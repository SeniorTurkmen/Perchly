    "Daha samimi bir bağ için dilediğin hitabı yaz. Takma ad üretilmez; yalnızca senin yazdığın kullanılır.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب طريقة المخاطبة التي تفضلها لتواصل أقرب. لا يتم إنشاء لقب تلقائياً — يُستخدم فقط ما تكتبه أنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe die Anrede, die du möchtest, für eine engere Verbindung. Es wird kein Spitzname generiert — es wird nur verwendet, was du schreibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write whatever form of address you'd like for a closer connection. No nickname is generated — only what you write is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la forma de dirigirte que prefieras para una conexión más cercana. No se genera ningún apodo; solo se usa lo que escribas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris la façon de t'appeler que tu préfères pour un lien plus proche. Aucun surnom n'est généré — seul ce que tu écris est utilisé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, как бы ты хотел, чтобы к тебе обращались, для более близкой связи. Никнейм не создаётся автоматически — используется только то, что напишешь ты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下你希望的称呼方式,以建立更亲近的联系。系统不会自动生成昵称——只会使用你所写的内容。"
          }
        }
      }
    },
    "Dayatmadan önerir, meraklı kalır.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح دون إلحاح، ويبقى فضولياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt vor, ohne zu drängen, bleibt neugierig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggests without pushing, stays curious."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere sin presionar, se mantiene curioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère sans insister, reste curieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает, не навязывая, сохраняет любопытство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出建议但不强求,始终保持好奇。"
          }
        }
      }
    },
    "Deneyimi yaşına göre kişiselleştirebilmemiz için yaş aralığını seçebilirsin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك اختيار فئتك العمرية لنتمكن من تخصيص التجربة لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine Altersgruppe wählen, damit wir die Erfahrung für dich personalisieren können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pick your age range so we can personalize the experience for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir tu rango de edad para que podamos personalizar la experiencia para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux choisir ta tranche d'âge afin que nous puissions personnaliser ton expérience."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты можешь выбрать свою возрастную группу, чтобы мы могли персонализировать опыт для тебя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以选择你的年龄段,以便我们为你个性化定制体验。"
          }
        }
      }
    },
