        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachrichten bleiben hier, solange du im selben Gespräch bleibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages stay here for as long as you remain in the same conversation."
