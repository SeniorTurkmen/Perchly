    "İstersen bunu atlayabilirsin; istediğin zaman değiştirebilirsin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تخطي هذا إذا أردت؛ يمكنك تغييره في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das überspringen, wenn du möchtest; du kannst es jederzeit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this if you like; you can change it anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes omitir esto si quieres; puedes cambiarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux passer cette étape si tu veux ; tu pourras la modifier à tout moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты можешь пропустить это, если хочешь; ты всегда сможешь это изменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你愿意,可以跳过此步骤;你可以随时更改。"
          }
        }
      }
    },
