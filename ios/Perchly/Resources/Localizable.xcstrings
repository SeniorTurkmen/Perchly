    "Motive olmak istediğin için bu eşleşmeyi öne çıkardık. İstersen başka birini seçebilirsin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرزنا هذا التطابق لأنك أردت الشعور بالتحفيز. يمكنك اختيار شخص آخر إن أردت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben diese Übereinstimmung hervorgehoben, weil du dich motivieren wolltest. Du kannst auch jemand anderen wählen, wenn du möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We highlighted this match because you wanted to feel motivated. You can choose someone else if you'd like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destacamos esta coincidencia porque querías sentirte motivado. Si quieres, puedes elegir a otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons mis en avant cette correspondance parce que tu voulais te sentir motivé. Tu peux choisir quelqu'un d'autre si tu préfères."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы выделили это совпадение, потому что ты хотел(а) почувствовать мотивацию. Если хочешь, можешь выбрать кого-то другого."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为你想获得激励,我们优先推荐了这个匹配。如果你愿意,也可以选择其他人。"
          }
        }
      }
    },
    "Pasif": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير نشط"
          }
        },
        "de": {
