    "E-postanı doğrula, cihaz değiştirsen de verilerin seninle kalsın.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من بريدك الإلكتروني حتى تبقى بياناتك معك حتى لو غيّرت جهازك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige deine E-Mail-Adresse, damit deine Daten bei dir bleiben, auch wenn du das Gerät wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your email so your data stays with you even if you switch devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu correo para que tus datos te acompañen incluso si cambias de dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ton e-mail pour que tes données restent avec toi même si tu changes d'appareil."
