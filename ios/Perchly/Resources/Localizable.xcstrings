    "İnsan ilişkilerinin tamamlayıcısı, her an yanında sakin bir sığınak.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكمّل للعلاقات الإنسانية — ملاذ هادئ بجانبك دائماً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ergänzung zu menschlichen Beziehungen — ein ruhiger Rückzugsort, immer an deiner Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complement to human relationships — a calm refuge always by your side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un complemento a las relaciones humanas: un refugio tranquilo siempre a tu lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un complément aux relations humaines — un refuge calme toujours à tes côtés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнение к человеческим отношениям — спокойное убежище, которое всегда рядом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为人际关系的补充,一个始终在你身边的宁静港湾。"
          }
        }
      }
    },
    "İsminle Hitap Edilsin": {
