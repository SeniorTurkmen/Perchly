    "Yaş bilgin gizli tutulur ve yalnızca eşleşme uyumunu artırmak için kullanılır.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الحفاظ على خصوصية عمرك ويُستخدم فقط لتحسين جودة التطابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Alter wird vertraulich behandelt und nur verwendet, um die Übereinstimmungsqualität zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your age is kept private and only used to improve match quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu edad se mantiene privada y solo se usa para mejorar la calidad de las coincidencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
