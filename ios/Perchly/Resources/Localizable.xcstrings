    "Gündelik sohbet aradığın için bu eşleşmeyi öne çıkardık. İstersen başka birini seçebilirsin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرزنا هذا التطابق لأنك كنت تبحث عن حديث يومي. يمكنك اختيار شخص آخر إن أردت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben diese Übereinstimmung hervorgehoben, weil du nach einem Alltagsgespräch gesucht hast. Du kannst auch jemand anderen wählen, wenn du möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We highlighted this match because you were looking for daily chat. You can choose someone else if you'd like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destacamos esta coincidencia porque buscabas una charla cotidiana. Si quieres, puedes elegir a otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons mis en avant cette correspondance parce que tu cherchais une discussion quotidienne. Tu peux choisir quelqu'un d'autre si tu préfères."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы выделили это совпадение, потому что ты искал(а) повседневное общение. Если хочешь, можешь выбрать кого-то другого."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为你在寻找日常闲聊,我们优先推荐了这个匹配。如果你愿意,也可以选择其他人。"
          }
        }
      }
    },
